{
    "name": "mnaji554/laravel-easypanel",
    "license": "MIT",
    "description": "An admin panel based on Livewire",
    "authors": [
        {
            "name": "Mohammed Almzah",
            "email": "almzah2020@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.23",
        "mnaji554/laravel-easyblade": "^2.0",
        "livewire/livewire": "^3.0",
        "mnaji554/dynamic-acl": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.x-dev"
    },
    "autoload": {
        "psr-4": {
            "EasyPanel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EasyPanelTest\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyPanel\\EasyPanelServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",

    "prefer-stable": true
}
