{
    "name": "mnaji554/laravel-easypanel",
    "license": "MIT",
    "description": "An admin panel based on Livewire",
    "authors": [
        {
            "name": "Reza Amini",
            "email": "rezaaminiroyal@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "mnaji554/laravel-easyblade": "dev-master",
        "livewire/livewire": "^3.0",
        "iya30n/dynamic-acl": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "EasyPanel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EasyPanelTest\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyPanel\\EasyPanelServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
